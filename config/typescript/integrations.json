{
	"extends": "./base.json",
	"compilerOptions": {
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"strict": false,
		"noUnusedLocals": false,
		"noUnusedParameters": false,
		"noUncheckedIndexedAccess": false,
		"exactOptionalPropertyTypes": false,
		"noImplicitOverride": false,
		"noPropertyAccessFromIndexSignature": false,
		"erasableSyntaxOnly": false
	},
	"include": [
		"../../packages/pi-stuff/src/web/runtime/**/*.ts",
		"../../packages/pi-stuff/src/mcp/runtime/**/*.ts",
		"../../test/mcp/agent-run-origin.test.ts",
		"../../test/mcp/command-secret.test.ts",
		"../../test/mcp/host-seam.test.ts",
		"../../test/mcp/runtime-owner.test.ts",
		"../../test/mcp/xdg-paths.test.ts",
		"../../test/web/extraction-process.test.ts"
	],
	"exclude": ["../../node_modules"]
}
