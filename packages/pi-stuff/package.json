{
	"name": "@jczhang02/pi-stuff",
	"version": "0.3.3",
	"description": "JC Zhang's complete local Pi coding-agent environment",
	"private": true,
	"type": "module",
	"keywords": [
		"pi-package",
		"pi",
		"extensions"
	],
	"license": "MIT",
	"exports": {
		".": "./index.ts"
	},
	"files": [
