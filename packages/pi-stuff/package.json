		"@napi-rs/keyring": "1.3.0",
		"@napi-rs/keyring-linux-x64-gnu": "1.3.0",
		"@types/json-schema": "7.0.15",
		"acorn": "8.17.0",
		"ai-tokenizer": "1.0.6",
		"ajv": "8.20.0",
		"ajv-formats": "3.0.1",
		"cross-spawn": "7.0.6",
		"jiti": "2.7.0",
		"linkedom": "0.16.11",
		"open": "10.2.0",
		"p-limit": "6.2.0",
