{
	"name": "@jczhang02/pi-stuff",
	"version": "0.1.0",
	"description": "The aggregate package for JC Zhang's Pi Stuff Suite",
	"type": "module",
	"keywords": [
		"pi-package",
		"pi",
		"extensions"
	],
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		".": "./index.ts"
	},
	"files": [
		"index.ts",
		"CHANGELOG.md",
		"README.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"dependencies": {
		"@jczhang02/pi-stuff-ui": "0.1.0",
		"@jczhang02/pi-stuff-tools": "0.1.0",
		"@jczhang02/pi-stuff-agents": "0.1.0",
		"@jczhang02/pi-stuff-todo": "0.1.0",
		"@jczhang02/pi-stuff-btw": "0.1.0"
	},
	"bundledDependencies": [
		"@jczhang02/pi-stuff-ui",
		"@jczhang02/pi-stuff-tools",
		"@jczhang02/pi-stuff-agents",
		"@jczhang02/pi-stuff-todo",
		"@jczhang02/pi-stuff-btw"
	],
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "0.83.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jczhang02/pi-stuff.git",
		"directory": "packages/pi-stuff"
	},
	"homepage": "https://github.com/jczhang02/pi-stuff/tree/main/packages/pi-stuff#readme",
	"bugs": {
		"url": "https://github.com/jczhang02/pi-stuff/issues"
	}
