{
	"name": "@jczhang02/pi-stuff-todo",
	"version": "0.1.0",
	"description": "A bounded, recoverable session Todo capability for Pi Stuff",
	"type": "module",
	"keywords": [
		"pi-package",
		"pi-extension",
		"todo",
		"tasks"
	],
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		".": "./index.ts"
	},
	"files": [
		"index.ts",
		"todo.ts",
		"todo-overlay.ts",
		"state/invariants.ts",
		"state/replay.ts",
		"state/state-reducer.ts",
		"state/state.ts",
		"state/store.ts",
		"state/task-graph.ts",
		"tool/response-envelope.ts",
		"tool/types.ts",
		"view/format.ts",
		"CHANGELOG.md",
		"README.md",
		"UPSTREAM.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"dependencies": {
		"@jczhang02/pi-stuff-tools": "0.1.0",
		"@jczhang02/pi-stuff-ui": "0.1.0",
		"typebox": "1.3.7"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "0.83.0",
		"@earendil-works/pi-tui": "0.83.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jczhang02/pi-stuff.git",
		"directory": "packages/pi-stuff-todo"
	},
	"homepage": "https://github.com/jczhang02/pi-stuff/tree/main/packages/pi-stuff-todo#readme",
	"bugs": {
		"url": "https://github.com/jczhang02/pi-stuff/issues"
	}
}
