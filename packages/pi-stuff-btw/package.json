		"@earendil-works/pi-tui": "0.83.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jczhang02/pi-stuff.git",
		"directory": "packages/pi-stuff-btw"
	},
	"homepage": "https://github.com/jczhang02/pi-stuff/tree/main/packages/pi-stuff-btw#readme",
	"bugs": {
		"url": "https://github.com/jczhang02/pi-stuff/issues"
