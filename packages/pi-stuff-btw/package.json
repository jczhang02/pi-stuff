{
	"name": "@jczhang02/pi-stuff-btw",
	"version": "0.1.2",
	"description": "A one-shot, context-isolated side-question capability for Pi Stuff",
	"type": "module",
	"keywords": [
		"pi-package",
		"pi-extension",
		"btw",
		"side-question"
	],
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		".": "./index.ts"
	},
	"files": [
		"index.ts",
		"btw.ts",
		"btw-budget.ts",
		"btw-history.ts",
		"btw-messages.ts",
		"btw-ui.ts",
		"pi-compat.ts",
		"prompts/btw-system.txt",
		"CHANGELOG.md",
		"README.md",
