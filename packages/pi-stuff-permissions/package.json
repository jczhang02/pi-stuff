{
	"name": "@jczhang02/pi-stuff-permissions",
	"version": "0.0.0",
	"description": "Quiet destructive-command protection for Pi Stuff",
	"type": "module",
	"keywords": [
		"pi-package",
		"pi-extension",
		"permissions",
		"access-control"
	],
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		".": "./src/index.ts",
		"./service": "./src/service.ts"
	},
	"imports": {
		"#src/*": "./src/*.ts"
	},
	"files": [
		"src",
		"schemas/permissions.schema.json",
		"README.md",
		"UPSTREAM.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"dependencies": {
		"@jczhang02/pi-stuff-ui": "0.0.0",
		"tree-sitter-bash": "0.25.1",
		"web-tree-sitter": "0.26.11",
		"zod": "4.4.3"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "0.83.0",
		"@earendil-works/pi-tui": "0.83.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jczhang02/pi-stuff.git",
		"directory": "packages/pi-stuff-permissions"
	},
	"homepage": "https://github.com/jczhang02/pi-stuff/tree/main/packages/pi-stuff-permissions#readme",
	"bugs": {
		"url": "https://github.com/jczhang02/pi-stuff/issues"
	}
}
