{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"workspaces": {
		".": {
			"entry": [
				"scripts/*.ts",
				"test/**/*.test.ts",
				"test/goal-upstream/**/*.node.ts",
				"test/goal-upstream/ui-node-shim.ts",
				"test/ui/settings-lock-race-worker.ts",
				"test/fixtures/**/*.ts",
				"test/agents/fixtures/**/*.ts"
			],
			"project": ["scripts/**/*.ts", "test/**/*.ts"]
		},
		"packages/pi-stuff": {
			"project": ["*.ts"],
			"ignoreDependencies": ["zod"]
		},
		"packages/pi-stuff-agents": {
			"entry": ["src/**/*.ts"],
			"project": ["**/*.ts"]
		},
		"packages/pi-stuff-btw": {
			"project": ["**/*.ts"]
		},
		"packages/pi-stuff-context": {
			"project": ["**/*.ts"],
			"ignoreDependencies": ["@cortexkit/pi-magic-context"]
		},
		"packages/pi-stuff-rtk": {
			"project": ["*.ts", "upstream/**/*.ts"],
			"ignore": ["upstream/**"]
		},
		"packages/pi-stuff-goal": {
			"project": ["**/*.ts"]
		},
		"packages/pi-stuff-mcp": {
			"project": ["**/*.ts"]
		},
		"packages/pi-stuff-todo": {
			"project": ["**/*.ts"]
		},
		"packages/pi-stuff-tools": {
			"project": ["**/*.ts"]
		},
		"packages/pi-stuff-ui": {
			"project": ["**/*.ts"]
		},
		"packages/pi-stuff-web": {
			"project": ["**/*.ts"]
		},
		"packages/pi-stuff-work": {
			"project": ["**/*.ts"],
			"ignoreDependencies": ["@earendil-works/pi-agent-core"]
		}
	}
}
