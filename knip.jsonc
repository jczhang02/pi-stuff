{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"workspaces": {
		".": {
			"entry": [
				"scripts/*.ts",
				"test/**/*.test.ts",
				"test/goal-upstream/**/*.node.ts",
				"test/goal-upstream/ui-node-shim.ts",
				"test/ui/settings-lock-race-worker.ts",
				"test/fixtures/**/*.ts",
				"test/agents/fixtures/**/*.ts"
			],
			"project": ["scripts/**/*.ts", "test/**/*.ts"]
		},
		"packages/pi-stuff": {
			"entry": ["src/subagents/src/runs/background/writer-process-supervisor.mjs"],
			"project": ["src/**/*.{ts,js,mjs,cjs}"],
			"ignore": ["src/web/runtime/**", "src/mcp/runtime/**"],
			"ignoreDependencies": ["@cortexkit/pi-magic-context", "@napi-rs/keyring", "@napi-rs/keyring-linux-x64-gnu"]
		}
	}
}
