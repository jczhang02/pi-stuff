{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"workspaces": {
		".": {
			"entry": [
				"scripts/*.ts",
				"test/**/*.test.ts",
				"test/fixtures/**/*.ts",
				"test/agents/fixtures/**/*.ts",
				"test/permissions/fixtures/**/*.ts"
			],
			"project": ["scripts/**/*.ts", "test/**/*.ts"]
		},
		"packages/pi-stuff": {
			"project": ["*.ts"]
		},
		"packages/pi-stuff-agents": {
			"entry": ["src/**/*.ts"],
			"ignoreDependencies": ["@jczhang02/pi-stuff-permissions"],
			"project": ["**/*.ts"]
		},
		"packages/pi-stuff-btw": {
			"project": ["**/*.ts"]
		},
		"packages/pi-stuff-permissions": {
			"entry": ["src/**/*.ts"],
			"ignoreDependencies": ["tree-sitter-bash"],
			"project": ["src/**/*.ts"]
		},
		"packages/pi-stuff-todo": {
			"project": ["**/*.ts"]
		},
		"packages/pi-stuff-ui": {
			"project": ["**/*.ts"]
		}
	}
}
