{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://raw.githubusercontent.com/jczhang02/pi-stuff/main/schemas/suite.schema.json",
	"title": "Pi Stuff Suite registry",
	"type": "object",
	"additionalProperties": false,
	"required": ["schemaVersion", "capabilities", "tools"],
	"properties": {
		"schemaVersion": {
			"const": 1
		},
		"capabilities": {
			"type": "array",
			"items": {
				"type": "string",
				"pattern": "^@jczhang02/pi-[a-z0-9-]+$"
			},
			"uniqueItems": true
		},
		"tools": {
			"type": "array",
			"items": {
				"type": "string",
				"minLength": 1
			},
			"uniqueItems": true
		},
		"deferredTools": {
			"type": "array",
			"description": "Aggregate-owned Tools that must declare Activity metadata but may register after session_start.",
			"items": {
				"type": "string",
				"minLength": 1
			},
			"uniqueItems": true
		},
		"optionalTools": {
			"type": "array",
			"items": {
				"type": "string",
				"minLength": 1
			},
			"uniqueItems": true
		}
	}
}
