{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"target": "ES2023",
		"lib": ["ES2023"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"exactOptionalPropertyTypes": false,
		"noUncheckedIndexedAccess": false
	},
	"include": ["packages/pi-stuff/src/rtk/**/*.ts", "test/rtk/**/*.ts"],
	"exclude": ["node_modules"]
}
