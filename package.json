{
	"name": "@jczhang02/pi-stuff-monorepo",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.3.14",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"acceptance:magic-context:real": "bun scripts/verify-magic-context-real.ts",
		"beads:publish": "bun scripts/publish-beads.ts",
		"benchmark:tool-activity": "bun scripts/benchmark-tool-activity.ts",
		"check": "bun run format:check && bun run typecheck && bun run test && bun run knip && bun run check:generated && bun run check:public && bun run benchmark:tool-activity && bun run pack:verify",
		"check:generated": "bun scripts/generate-suite.ts --check",
		"check:public": "bun scripts/check-public-safety.ts",
		"format": "biome check --write .",
		"format:check": "biome check .",
		"host:build": "bun scripts/build-certified-pi-host.ts",
		"host:model-data:refresh": "bun scripts/refresh-certified-pi-model-data.ts",
		"knip": "knip --no-progress",
		"pack:verify": "bun scripts/verify-package.ts",
		"release:pack": "bun scripts/pack-release.ts",
		"release:install-local": "bun scripts/install-certified-release.ts",
		"release:install:verify": "bun scripts/verify-local-release-install.ts",
		"release:publish": "bun scripts/publish-release.ts",
		"release:version": "changeset version && bun run suite:generate && bun install --ignore-scripts",
		"suite:generate": "bun scripts/generate-suite.ts",
		"test": "bun test --timeout 30000 && bun run test:goal",
		"test:goal": "bun scripts/test-goal-upstream.ts",
		"typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.rtk.json && tsc --noEmit -p tsconfig.agents.json && tsc --noEmit -p tsconfig.agents-tests.json && tsc --noEmit -p tsconfig.goal.json && tsc --noEmit -p tsconfig.goal-tests.json"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.7",
		"@changesets/cli": "2.31.1",
		"@earendil-works/pi-agent-core": "0.84.0",
		"@earendil-works/pi-ai": "0.84.0",
		"@earendil-works/pi-coding-agent": "0.84.0",
		"@earendil-works/pi-tui": "0.84.0",
		"@types/bun": "1.3.14",
		"knip": "6.32.0",
		"typebox": "1.3.11",
		"typescript": "7.0.2"
	},
	"trustedDependencies": [],
	"engines": {
		"bun": "1.3.14"
	}
}
