{
	"name": "@jczhang02/pi-stuff-monorepo",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.3.14",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"beads:publish": "bun scripts/publish-beads.ts",
		"check": "bun run format:check && bun run typecheck && bun run test && bun run knip && bun run check:generated && bun run check:public && bun run pack:verify",
		"check:generated": "bun scripts/generate-suite.ts --check",
		"check:public": "bun scripts/check-public-safety.ts",
		"format": "biome check --write .",
		"format:check": "biome check .",
		"knip": "knip --no-progress",
		"pack:verify": "bun scripts/verify-package.ts",
		"suite:generate": "bun scripts/generate-suite.ts",
		"test": "bun test --timeout 30000",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.6",
		"@changesets/cli": "2.31.1",
		"@earendil-works/pi-coding-agent": "0.83.0",
		"@types/bun": "1.3.14",
		"knip": "6.30.0",
		"typescript": "7.0.2"
	},
	"trustedDependencies": [],
	"engines": {
		"bun": "1.3.14"
	}
}
