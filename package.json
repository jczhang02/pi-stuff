{
  "name": "pi-stuff",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "bun test tests",
    "format": "bun --bun oxfmt --write .",
    "format:check": "bun --bun oxfmt --check .",
    "lint": "bun --bun oxlint --deny-warnings --disable-nested-config",
    "typecheck": "bun --bun tsc --noEmit",
    "hooks:install": "bun --bun husky",
    "tui": "bun --bun tuistory",
    "check": "bun run format:check && bun run lint && bun run typecheck"
  },
  "dependencies": {
    "@mozilla/readability": "0.6.0",
    "effect": "4.0.0-rc.112",
    "linkedom": "0.18.13",
    "turndown": "7.2.4",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@arhen/pi-core-subagent": "1.3.54",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@oxlint/plugins": "1.82.0",
    "@types/bun": "1.4.0",
    "@types/turndown": "5.0.6",
    "husky": "9.1.7",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "tuistory": "0.11.0",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1"
  },
  "engines": {
    "bun": "1.4.0"
  },
  "packageManager": "bun@1.4.0",
  "patchedDependencies": {
    "@arhen/pi-core-subagent@1.3.54": "patches/@arhen%2Fpi-core-subagent@1.3.54.patch"
  },
  "pi": {
    "extensions": [
      "./src/pi/index.ts"
    ]
  }
}
