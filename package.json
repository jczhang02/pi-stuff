{
  "name": "pi-stuff",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": "1.4.0"
  },
  "scripts": {
    "typecheck": "bun --bun tsc --noEmit",
    "test": "bun test",
    "check:repo": "bun scripts/check-repo.ts",
    "check:pr": "bun scripts/check-pr.ts",
    "check": "bun run typecheck && bun run test && bun run check:repo"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "typescript": "7.0.2",
    "yaml": "2.9.0"
  }
}
