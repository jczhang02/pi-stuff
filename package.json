{
	"name": "@jczhang02/pi-stuff-development",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.3.14",
	"workspaces": [
		"packages/pi-stuff"
	],
	"scripts": {
		"acceptance:code-mode:real": "bun scripts/verify-code-mode-real.ts",
		"acceptance:code-mode:tui": "bun scripts/verify-code-mode-tui.ts",
		"acceptance:magic-context:real": "bun scripts/verify-magic-context-real.ts",
		"beads:publish": "bun scripts/publish-beads.ts",
		"benchmark:lifecycle": "bun scripts/benchmark-lifecycle.ts --acceptance --trace",
		"benchmark:tool-activity": "bun scripts/benchmark-tool-activity.ts",
		"ci:acceptance-scope": "bun scripts/ci-acceptance-scope.ts",
		"check": "bun run format:check && bun run typecheck && bun run test && bun run knip && bun run check:generated && bun run check:repository && bun run benchmark:tool-activity && bun run pack:verify",
		"check:generated": "bun scripts/generate-suite.ts --check",
		"check:repository": "bun scripts/check-repository-safety.ts",
		"format": "biome check --write .",
		"format:check": "biome check .",
		"host:build": "bun scripts/build-certified-pi-host.ts",
		"host:model-data:refresh": "bun scripts/refresh-certified-pi-model-data.ts",
		"knip": "knip --no-progress --include files,dependencies,unlisted,binaries,unresolved,cycles",
		"pack:verify": "bun scripts/verify-package.ts",
		"suite:generate": "bun scripts/generate-suite.ts",
		"test": "bun run test:isolated && bun run test:goal",
		"test:ci": "bun run test:isolated && bun run test:goal",
		"test:goal": "bun scripts/test-goal-upstream.ts",
		"test:isolated": "bun scripts/run-isolated-tests.ts",
		"typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.integrations.json && tsc --noEmit -p tsconfig.rtk.json && tsc --noEmit -p tsconfig.agents.json && tsc --noEmit -p tsconfig.agents-tests.json && tsc --noEmit -p tsconfig.goal.json && tsc --noEmit -p tsconfig.goal-tests.json"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.6",
		"@earendil-works/pi-agent-core": "0.84.1",
		"@earendil-works/pi-ai": "0.84.1",
		"@earendil-works/pi-coding-agent": "0.84.1",
		"@earendil-works/pi-tui": "0.84.1",
		"@types/bun": "1.3.14",
		"knip": "6.30.0",
		"typebox": "1.3.10",
		"typescript": "5.9.3"
	},
	"trustedDependencies": [],
	"engines": {
		"bun": "1.3.14"
	}
}
