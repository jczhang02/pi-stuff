{
  "name": "pi-stuff",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "format": "bun --bun oxfmt --write .",
    "format:check": "bun --bun oxfmt --check .",
    "lint": "bun --bun oxlint --deny-warnings --disable-nested-config",
    "typecheck": "bun --bun tsc --noEmit",
    "hooks:install": "bun --bun husky",
    "tui": "bun --bun tuistory",
    "check": "bun run format:check && bun run lint && bun run typecheck"
  },
  "dependencies": {
    "effect": "4.0.0-rc.112"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@oxlint/plugins": "1.82.0",
    "@types/bun": "1.4.0",
    "husky": "9.1.7",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "tuistory": "0.11.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": "1.4.0"
  },
  "packageManager": "bun@1.4.0"
}
